<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <!-- Cream background with subtle gold border -->
  <rect width="100" height="100" rx="20" fill="#FFF8E7"/>
  <rect x="3" y="3" width="94" height="94" rx="18" fill="none" stroke="#D4AF37" stroke-width="2" opacity="0.4"/>
  
  <!-- Saffron filled circle as backdrop -->
  <circle cx="50" cy="50" r="36" fill="#FF9933"/>
  
  <!-- Sanskrit "सि" (Si - first syllable of Siddhi) in white -->
  <text x="50" y="68" 
        font-family="'Tiro Devanagari Sanskrit', 'Noto Sans Devanagari', serif" 
        font-size="52" 
        font-weight="700"
        text-anchor="middle" 
        fill="#FFFFFF">सि</text>
</svg>